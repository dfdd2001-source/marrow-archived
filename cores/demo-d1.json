  "dictionary": [
    {
      "term": "线性变换（linear transformation）",
      "definition": "满足 T(u+v) = Tu + Tv 且 T(cv) = c·Tv 的映射 T，它把向量变成向量、保持加法与数乘结构。",
      "source_ref": "定义D1.1",
      "verified_by": "engineer"
    },
    {
      "term": "矩阵表示（matrix of a linear map）",
      "definition": "把 T 作用在标准基的每个基向量上，把所得向量按列排成矩阵 M(T)；之后 Tv = M(T)·v 就是普通的矩阵乘向量。",
      "source_ref": "定义D1.2",
      "verified_by": "engineer"
    },
    {
      "term": "行列式（determinant）",
      "definition": "2×2 矩阵 [[a,b],[c,d]] 的行列式为 ad − bc；det = 0 当且仅当矩阵不可逆（变换把平面压扁）。",
      "source_ref": "定义D1.3",
      "verified_by": "engineer"
    }
  ],
