      "id": "alg_d1_matvec",
      "name": "矩阵-向量乘法",
      "statement": "对 M=[[a,b],[c,d]] 与 v=(x,y)：Mv = (ax+by, cx+dy)。这就是线性变换作用在向量上的坐标计算。",
      "source_ref": "结论D1.4",
      "executable": true,
      "verified_by": "engineer"
    },
    {
      "id": "alg_d1_det",
      "name": "2×2 行列式与可逆判据",
      "statement": "det [[a,b],[c,d]] = ad − bc；det ≠ 0 ⟺ 可逆（det=0 时平面被压扁，信息丢失不可逆）。",
      "source_ref": "结论D1.5",
      "executable": true,
      "verified_by": "engineer"
    }
  ],
